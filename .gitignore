# ============================================================
# F1C200S Embedded Linux BSP
#
# Track all source code:
#   Linux Kernel / U-Boot / Buildroot / Drivers / Applications
#
# Ignore generated files, build artifacts and local tools.
# ============================================================


# ------------------------------------------------------------
# 1. Toolchains (prebuilt binaries)
# ------------------------------------------------------------

/toolchain/


# ------------------------------------------------------------
# 2. Project output and generated images
# ------------------------------------------------------------

/output/
/images/


# ------------------------------------------------------------
# 3. Linux kernel generated files
# ------------------------------------------------------------

*.o
*.o.*
*.a
*.so
*.so.*
*.ko
*.ko.*
*.mod
*.mod.c
*.mod.o
*.cmd
.*.cmd

*.dtb
*.dtbo
*.dtb.S

Module.symvers
modules.order

.tmp_versions/
.tmp_*/

vmlinux
vmlinux.*
System.map

zImage
uImage
Image.gz

# Kernel generated configuration and headers
**/include/generated/
**/include/config/
**/arch/*/include/generated/

# Kernel temporary files
*.symtypes
*.order
*.gcno
*.gcda

# Kernel build metadata
*.dwo
*.su


# ------------------------------------------------------------
# 4. U-Boot generated files
# ------------------------------------------------------------
/bootloader/u-boot/u-boot
u-boot.bin
u-boot.img
u-boot.elf
u-boot.map
u-boot.sym
u-boot.cfg

u-boot-sunxi-with-spl.bin

MLO
SPL

# U-Boot generated binaries
*.bin
*.elf
*.map


# ------------------------------------------------------------
# 5. Buildroot generated output
# ------------------------------------------------------------

/rootfs/buildroot/output/

# Root filesystem archives
rootfs.tar
rootfs.tar.gz
rootfs.tar.xz

*.cpio
*.cpio.gz
*.ext2
*.ext3
*.ext4
*.squashfs
*.jffs2
*.ubi
*.ubifs


# ------------------------------------------------------------
# 6. Disk images
# ------------------------------------------------------------

*.img
*.iso
*.qcow2
*.vmdk
*.vdi


# ------------------------------------------------------------
# 7. Compiled executables and temporary binaries
# ------------------------------------------------------------

/drivers/led_driver/led
/drivers/led_driver/led_b

*.exe
*.out


# ------------------------------------------------------------
# 8. Logs and temporary files
# ------------------------------------------------------------

*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

/docs/logs/


# ------------------------------------------------------------
# 9. Python cache
# ------------------------------------------------------------

__pycache__/
*.pyc
*.pyo

.venv/
venv/


# ------------------------------------------------------------
# 10. IDE files
# ------------------------------------------------------------

.vscode/
.idea/
*.code-workspace


# ------------------------------------------------------------
# 11. OS files
# ------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini
